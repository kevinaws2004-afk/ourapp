<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: what Android's device backup (Google) and device-to-device
     transfer carry to a new phone. Daylog keeps everything on the device;
     Android's own backup, if the person has it on, includes the database
     (app_flutter/) and the daily backups (files/backups/). Temporary
     exports in the cache are never included. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/" />
        <include domain="file" path="backups/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/" />
        <include domain="file" path="backups/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
